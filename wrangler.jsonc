// PL: Ustawienia Workera Cloudflare: nazwa, plik z kodem serwera i sposób wysyłania plików aplikacji.
// EN: Cloudflare Worker settings: the name, the server code file and how the app files are served.
//
// @author Bohdan
// @since 2026-10-09
// @uses worker/index.ts::app
// @used_by vite.config.ts::cloudflare
// @used_by vitest.config.ts::cloudflareTest
// @used_by scripts/db.ts::getPlatformProxy
{
  // PL: Nazwa Workera w Cloudflare.
  // EN: The Worker name in Cloudflare.
  "name": "teb-student",
  // PL: Plik z kodem serwera.
  // EN: The server code file.
  "main": "worker/index.ts",
  // PL: Data zgodności środowiska Workers: ustala, jak zachowują się funkcje platformy. Nie może być późniejsza niż wersja workerd z package-lock.json.
  // EN: Workers compatibility date: fixes how platform features behave. It must not be later than the workerd version in package-lock.json.
  "compatibility_date": "2026-10-01",
  // PL: Pliki aplikacji wysyła Cloudflare, bez użycia procesora Workera.
  // EN: Cloudflare serves the app files, without using Worker CPU time.
  "assets": {
    // PL: Nieznany adres otwiera aplikację, bo ekrany wybiera React Router w telefonie.
    // EN: An unknown URL opens the app, because React Router picks the screens in the phone.
    "not_found_handling": "single-page-application",
    // PL: Adresy /api/ trafiają zawsze do Workera, a nie do plików.
    // EN: /api/ URLs always go to the Worker, not to files.
    "run_worker_first": ["/api/*"]
  },
  // PL: Baza D1. Kod serwera czyta ją jako env.DB (typ Env w worker/shared/index.ts).
  // PL: Pola database_id jeszcze nie ma: bazę zakładasz w koncie Cloudflare. Po `wrangler d1 create teb-student` (docs/WDROZENIE.md, krok 3) wpisz tu identyfikator z wyniku polecenia, zanim wykonasz kroki z --remote. Lokalnie (npm run dev, npm test, npm run db:reset) Wrangler zakłada bazę sam i trzyma ją w .wrangler/state.
  // PL: Tabel nie zakłada wdrożenie: robi to schemat (docs/WDROZENIE.md, krok 5).
  // EN: The D1 database. The server code reads it as env.DB (the Env type in worker/shared/index.ts).
  // EN: The database_id field is not here yet: you create the database in the Cloudflare account. After `wrangler d1 create teb-student` (docs/WDROZENIE.md, step 3) type the id from the command output here, before the --remote steps. Locally (npm run dev, npm test, npm run db:reset) Wrangler creates the database by itself and keeps it in .wrangler/state.
  // EN: A deploy does not create the tables: the schema does (docs/WDROZENIE.md, step 5).
  "d1_databases": [
    {
      // PL: Nazwa bindingu, pod którą baza jest w env.
      // EN: The binding name under which the database is in env.
      "binding": "DB",
      // PL: Nazwa bazy w Cloudflare i w poleceniach Wranglera.
      // EN: The database name in Cloudflare and in Wrangler commands.
      "database_name": "teb-student"
    }
  ],
  // PL: Zasobnik R2 na zdjęcia i filmy (podtor 2). Kod serwera czyta go jako env.MEDIA (typ Env w worker/shared/index.ts).
  // EN: The R2 bucket for photos and videos (subtrack 2). The server code reads it as env.MEDIA (the Env type in worker/shared/index.ts).
  // PL: Zasobnik tworzysz w koncie ręcznie (docs/WDROZENIE.md, krok 3, sekcja R2). Lokalnie (npm run dev, npm test) Wrangler sam tworzy zasobnik w .wrangler/state.
  // EN: You create the bucket in the account by hand (docs/WDROZENIE.md, step 3, the R2 section). Locally (npm run dev, npm test) Wrangler creates the bucket by itself in .wrangler/state.
  "r2_buckets": [
    {
      // PL: Nazwa bindingu, pod którą zasobnik jest w env.
      // EN: The binding name under which the bucket is in env.
      "binding": "MEDIA",
      // PL: Nazwa zasobnika w Cloudflare R2.
      // EN: The bucket name in Cloudflare R2.
      "bucket_name": "teb-media"
    }
  ]
}
