  // EN: No files of its own.
  "files": [],
  // PL: Trzy zestawy: telefon, serwer, narzędzia.
  // EN: Three sets: phone, server, tools.
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.worker.json" },
    { "path": "./tsconfig.node.json" }
